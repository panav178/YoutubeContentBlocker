{
  "manifest_version": 3,
  "name": "YouTube Content Blocker",
  "version": "0.1.0",
  "description": "Hide distracting YouTube surfaces like recommendations, Shorts, comments, and end-screen suggestions.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://youtube.com/*",
    "*://m.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "YouTube Content Blocker",
    "default_popup": "popup/popup.html"
  }
}
